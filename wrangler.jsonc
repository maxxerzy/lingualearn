// Cloudflare-Workers-Konfiguration.
// Diese Datei muss committet sein: ohne sie generiert wranglers Auto-Setup im
// Build-Container eine eigene Config UND installiert wrangler als devDependency,
// wodurch node_modules (u. a. die 121-MB-workerd-Binary) im Assets-Upload
// landet und das 25-MiB-Limit sprengt.
//
// Statische Dateien werden weiterhin direkt ausgeliefert (Workers Static
// Assets greifen VOR dem Worker-Code) — der Worker bedient nur /api/… für
// die Geräte-Synchronisation.
{
  "name": "lingualearn",
  "compatibility_date": "2026-07-06",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // Geräte-Sync: KV-Namespace „lingualearn-sync".
  // Fehlt dieses Binding, läuft die App normal weiter und die Sync-
  // Endpunkte antworten mit „nicht eingerichtet".
  "kv_namespaces": [
    { "binding": "SYNC", "id": "c21e52b41493402c93774835dafe3537" }
  ]
}
